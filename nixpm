#!/usr/bin/env python3

import sys
import subprocess
from pathlib import Path

CONFIG_PATH = Path("/etc/nixos/config.nix")

def print_help():
    print("nixpm — add/remove packages in configuration.nix like apt install")
    print("Usage:")
    print("    nixpm install <package> [<package> ...]")
    print("    nixpm remove  <package> [<package> ...]")
    print("    nixpm list")
    print("    nixpm search  <term>")

def write_package_to_config(package):
    content = CONFIG_PATH.read_text()
    lines = content.split('\n')
    
    packages_idx = None
    for i, line in enumerate(lines):
        if 'environment.systemPackages = with pkgs; [' in line:
            packages_idx = i
            break
    if packages_idx is None:
        return False
    close_bracket_idx = None
    for i in range(packages_idx + 1, len(lines)):
        if lines[i].strip() == '];':
            close_bracket_idx = i
            break
    if close_bracket_idx is None:
        return False
    indent = "        "
    lines.insert(close_bracket_idx, f"{indent}{package}")
    CONFIG_PATH.write_text('\n'.join(lines))
    return True

def cmd_install(packages):
    content = CONFIG_PATH.read_text()

    for package in packages:
        if package in content:
            print(f"Package {package} is already installed")
        else:
            write_package_to_config(package)    
    try:
        subprocess.run(["sudo", "nixos-rebuild", "switch"], check=True)
    except subprocess.CalledProcessError:
        print("Error: nixos-rebuild switch failed")


def remove_packages_from_config(packages):
    content = CONFIG_PATH.read_text()
    lines = content.split('\n')
    removed = []
    new_lines = []
    for line in lines:
        token = line.strip()
        if token in packages:
            removed.append(token)
        else:
            new_lines.append(line)
    if removed:
        CONFIG_PATH.write_text('\n'.join(new_lines))
    return removed

def cmd_remove(packages):
    if not packages:
        print("Usage: nixpm remove <package> [<package> ...]")
        sys.exit(1)
    removed = remove_packages_from_config(packages)
    for pkg in packages:
        if pkg in removed:
            print(f"Removed {pkg}")
        else:
            print(f"Package {pkg} not found in config")
    if removed:
        try:
            subprocess.run(["sudo", "nixos-rebuild", "switch"], check=True)
        except subprocess.CalledProcessError:
            print("Error: nixos-rebuild switch failed")

def error_handler(args):
    if len(args) < 2:
        print_help()
        sys.exit(1)

    if args[1] in ("-h", "--help"):
        print_help()
        sys.exit(0)

def main():
    error_handler(sys.argv)

    functions = {
        "install": cmd_install,
        "remove": cmd_remove
    }

    command = sys.argv[1]

    if command not in functions:
        print("Invalid function")
        sys.exit(1)

    functions[command](sys.argv[2:])

if __name__ == "__main__":
    main()